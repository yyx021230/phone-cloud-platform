# Local candidate example: merge into the existing business server block only
# after reviewing upstream/auth headers. Do not replace media/control locations.
location = /api/v1/open/name-lookups/query {
    proxy_pass http://phone_cloud_backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 210s;
    proxy_send_timeout 30s;
    proxy_next_upstream off;
}
# The existing production upstream name must be verified before deployment.
# Do not infer that this example has been applied or production-tested.
