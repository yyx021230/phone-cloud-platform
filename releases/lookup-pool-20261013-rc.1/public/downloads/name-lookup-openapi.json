    {
      "name": "lookup-user",
      "description": "支付宝查名字 · 业务接口"
    }
  ],
  "paths": {
    "/api/v1/open/name-lookups/devices": {
      "get": {
        "operationId": "get-api-v1-open-name-lookups-devices",
        "summary": "获取可用查名设备",
        "description": "只返回客户端精确白名单中的已存在设备。available 是瞬时信息，创建会话仍可能发生设备争用。",
        "tags": [
          "lookup-user"
        ],
        "deprecated": false,
        "security": [
          {
            "HmacSignature": []
          }
        ],
        "x-platform-auth": "hmac",
        "x-agent-scope": "",
        "parameters": [
          {
            "name": "X-Client-Id",
            "in": "header",
            "required": true,
            "description": "管理员交付的客户端ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Timestamp",
            "in": "header",
            "required": true,
            "description": "Unix毫秒字符串，默认容差5分钟",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Nonce",
            "in": "header",
            "required": true,
