            "description": "管理员交付的客户端ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Timestamp",
            "in": "header",
            "required": true,
            "description": "Unix毫秒字符串，默认容差5分钟",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Nonce",
            "in": "header",
            "required": true,
            "description": "每请求唯一，8–120字符A-Z/a-z/0-9/._:-",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "8–160字符A-Z/a-z/0-9/._:-；同业务重试保持同键，重新签名",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9._:-]{8,160}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功受理或幂等重放，任务完成需另查状态",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "session": {
                      "$ref": "#/components/schemas/OpenLookupSession"
                    },
                    "idempotent": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "201": {
            "description": "成功受理或幂等重放，任务完成需另查状态",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "session": {
                      "$ref": "#/components/schemas/OpenLookupSession"
                    },
                    "idempotent": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "错误；HTTP状态和error字符串见门户错误参考。扩展字段可包含session/detail/retryAfterSeconds。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "deviceId": {
                    "type": "string",
                    "description": "平台稳定设备ID，例如 adb:SERIAL-DEMO；不是界面编号"
                  }
                },
                "additionalProperties": true,
                "required": [
                  "deviceId"
                ]
              }
            }
          }
        },
