# Include only in the reviewed business server block during the release window.
# The HTTP or HTTPS listener is decided separately. No new public listener here.
location = /api/v1/lead/devices/query {
    proxy_pass http://127.0.0.1:8797;
    proxy_next_upstream off;
    client_max_body_size 16k;
    proxy_connect_timeout 2s;
    proxy_send_timeout 10s;
    proxy_read_timeout 15s;
}

location = /api/v1/lead/dispatch {
    proxy_pass http://127.0.0.1:8797;
    proxy_next_upstream off;
    client_max_body_size 16k;
    proxy_connect_timeout 2s;
    proxy_send_timeout 10s;
    proxy_read_timeout 15s;
}
