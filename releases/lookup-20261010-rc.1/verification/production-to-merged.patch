+  return inputs.length === 1 && inputs[0].enabled === "true" && inputs[0]["visible-to-user"] !== "false"
+    ? "search_ready" : "unknown";
+}
+
+export function createLookupHumanObserver({ request, observe, canObserve, agentId, maxPerPoll = 3 }) {
+  let running = false;
+  let stopped = false;
+  let cursor = 0;
+  return {
+    stop() { stopped = true; },
+    async poll() {
+      if (running || stopped) return;
+      running = true;
+      try {
+        const path = `/api/v1/windows-agents/${encodeURIComponent(agentId)}/lookup-human-verifications`;
+        const { probes = [] } = await request(path, { timeoutMs: 5_000 });
+        if (!probes.length) return;
+        const start = cursor % probes.length;
+        cursor += Math.min(maxPerPoll, probes.length);
+        for (let offset = 0; offset < Math.min(maxPerPoll, probes.length) && !stopped; offset += 1) {
+          const probe = probes[(start + offset) % probes.length];
+          let state = "unknown";
+          if (canObserve(probe)) {
+            try { state = await observe(probe); } catch { /* Failed reads are never clear. */ }
+          }
+          if (stopped) return;
+          await request(path, { method: "POST", timeoutMs: 5_000, body: {
+            probeId: probe.probeId,
+            state: ["present", "search_ready"].includes(state) ? state : "unknown"
+          } });
+        }
+      } finally { running = false; }
+    }
+  };
+}
