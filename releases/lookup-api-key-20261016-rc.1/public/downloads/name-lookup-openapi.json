                    "ok",
                    "lookupId",
                    "status",
                    "reused"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "lookupId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "queued",
                        "processing",
                        "completed",
                        "failed"
                      ]
                    },
                    "reused": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "ok": true,
                  "lookupId": "00000000-0000-4000-8000-000000000002",
                  "status": "queued",
                  "reused": false
                }
              }
            }
          },
