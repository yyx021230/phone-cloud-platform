HOST=0.0.0.0
PORT=8787
NODE_ENV=production
STRICT_PRODUCTION_CONFIG=false
ALLOW_JSON_STORAGE_IN_PRODUCTION=false
STORAGE_BACKEND=postgres
DATABASE_URL=postgres://phone_cloud:change-me-postgres-password@postgres:5432/phone_cloud
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_SSL=false
POSTGRES_STATE_KEY=default
POSTGRES_BOOTSTRAP_FROM_JSON=false
STRUCTURED_TABLE_SYNC=false
STRUCTURED_WRITES=true
REDIS_URL=redis://redis:6379/0
REDIS_COMMAND_TIMEOUT_MS=1500
DEVICE_ONLINE_TTL_SECONDS=45
SCREEN_MAX_CONCURRENT_SESSIONS=20
SCREEN_MEDIA_SLOT_COUNT=20
SCREEN_RELAY_BANDWIDTH_MBPS=100
SCREEN_MEDIA_TRANSPORT=websocket
# Use direct_webrtc for the experimental Agent-to-browser media path.
SCREEN_MEDIA_PUBLISH_TRANSPORT=rtsp
SCREEN_MEDIA_WHIP_PUBLISH_BASE_URL=http://127.0.0.1:8787/webrtc
SCREEN_MEDIA_AUTH_SECRET=replace-with-a-dedicated-random-secret-at-least-32-characters
SCREEN_MEDIA_TOKEN_TTL_SECONDS=600
SCREEN_MEDIA_WHEP_BASE_URL=http://127.0.0.1:8787/webrtc
SCREEN_MEDIA_RTSP_PUBLISH_BASE_URL=rtsp://127.0.0.1:8554
# Direct WebRTC needs server-reflexive candidates when the Agent and browser
# are on different private networks. Add TURN here for networks that block
# UDP hole punching; STUN alone does not provide a relay.
SCREEN_WEBRTC_ICE_SERVERS_JSON=[{"urls":["stun:stun.cloudflare.com:3478"]},{"urls":["stun:stun.l.google.com:19302"]}]
EVIDENCE_DIR=evidence
EVIDENCE_SIGNING_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
EVIDENCE_URL_TTL_SECONDS=300
PUBLIC_BASE_URL=http://127.0.0.1:8787
TRUSTED_ORIGINS=http://127.0.0.1:8787
ADMIN_API_TOKEN=dev-admin-token
WINDOWS_AGENT_TOKEN=dev-windows-token
LEGACY_WINDOWS_AGENT_TOKEN_ENABLED=false
DEVICE_AGENT_TOKEN=dev-device-token
THIRD_PARTY_API_CLIENTS=demo-client:change-me-at-least-16-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
MIN_PASSWORD_LENGTH=12
SESSION_TTL_HOURS=24
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_MAX=8
SMS_ORDER_TTL_SECONDS=300
WINDOWS_TASK_TTL_SECONDS=300
XHS_TASK_TTL_SECONDS=600
USER_MAX_WAITING_SMS=1
USER_MAX_ACTIVE_XHS_TASKS=3
DEVICE_MAX_ACTIVE_XHS_TASKS=1
MAX_QR_IMAGE_BYTES=3000000
REQUEST_TIMEOUT_SECONDS=120
KEEP_ALIVE_TIMEOUT_SECONDS=65
HEADERS_TIMEOUT_SECONDS=70
RETENTION_DAYS=30
MAX_SMS_ORDERS=5000
MAX_SMS_EVENTS=10000
MAX_SMS_MESSAGES=50000
MAX_WINDOWS_TASKS=5000
MAX_XHS_TASKS=5000
MAX_EVIDENCE_ASSETS=10000
MAX_AUDIT_EVENTS=5000
MAX_SESSIONS=5000
DATA_DIR=./data
